# 数据源
# GitHub 不配置令牌也能运行，但接口频率限制更低。
GITHUB_TOKEN=

# Product Hunt 为可选数据源；未配置令牌时会自动跳过。
PRODUCT_HUNT_TOKEN=

# 模型配置
# 支持 DeepSeek、OpenAI 以及其他兼容 OpenAI 接口格式的服务。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.2

# 一次批量分析最多包含 4 条政策和 10 个项目。
# Thinking 模式的推理 Token 与最终正文共同占用 completion 预算。
# 默认 131072；代码允许最高 384000。实际按真实生成量计费。
LLM_MAX_TOKENS=131072

# 日报属于离线分析任务，默认允许单次 DeepSeek 请求最长运行 15 分钟。
LLM_TIMEOUT_SECONDS=900

# 飞书
FEISHU_WEBHOOK=

# 自定义机器人官方请求体硬限制为 20 KB；项目使用 18 KiB 软预算。
# 业务文案不设置字符硬上限；超过单卡安全预算时自动拆分为多张卡片。
FEISHU_MAX_PAYLOAD_BYTES=18432

# 产品机会页优先每张展示 5 个项目；超过后继续分页，不丢弃后续项目或正文。
FEISHU_PROJECTS_PER_CARD=5
FEISHU_MAX_RETRIES=3
FEISHU_SEND_TIMEOUT_SECONDS=10

# 飞书卡片会先持久化再发送；进程/容器重启后继续补发尚未成功的卡片。
FEISHU_OUTBOX_DIR=./data/feishu-outbox

# 日报语言和显示时区；调度器也使用同一时区。
REPORT_LOCALE=zh-CN
REPORT_TIMEZONE=Asia/Shanghai

# 数据库
# Docker Compose 会将 ./data 持久化到容器的 /app/data。
# SQLite 运行时启用 WAL、busy_timeout 和连接预检，以降低 database is locked 风险。
DATABASE_URL=sqlite:///./data/radar.db

# data 目录保护。可用空间低于阈值时，日报会在调用 DeepSeek 前停止。
DATA_MIN_FREE_MB=256

# 每轮写入前使用 SQLite backup API 创建一致性备份，并只保留最近若干份。
DATABASE_BACKUP_DIR=./data/backups
DATABASE_BACKUP_RETENTION=7

# 保存最近执行的轻量摘要，不保存完整项目内容、URL、API Key 或 Webhook。
RUN_HISTORY_FILE=./data/run-history.json
RUN_HISTORY_LIMIT=100

# 定时任务
RADAR_RUN_HOUR=8
RADAR_RUN_MINUTE=0
