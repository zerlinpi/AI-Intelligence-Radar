# 数据源
# GitHub 不配置令牌也能运行，但接口频率限制更低。
GITHUB_TOKEN=

# Product Hunt 为可选数据源；未配置令牌时会自动跳过。
PRODUCT_HUNT_TOKEN=

# 模型配置
# 支持 DeepSeek、OpenAI 以及其他兼容 OpenAI 接口格式的服务。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# Top 10 使用一次批量短分析，默认 700 Token 即可。
LLM_MAX_TOKENS=700

# 飞书
FEISHU_WEBHOOK=

# 数据库
# Docker Compose 会将 ./data 持久化到容器的 /app/data。
DATABASE_URL=sqlite:///./data/radar.db

# 定时任务
# 调度器时区：Asia/Shanghai（UTC+8）
RADAR_RUN_HOUR=8
RADAR_RUN_MINUTE=0
