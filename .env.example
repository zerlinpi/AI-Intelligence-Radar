# Data Sources
# GitHub works without a token at lower API rate limits.
GITHUB_TOKEN=

# Product Hunt is optional. Without a token this source is skipped.
PRODUCT_HUNT_TOKEN=

# LLM Provider Configuration
# Supported: OpenAI, DeepSeek, and other OpenAI-compatible APIs.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# Feishu
FEISHU_WEBHOOK=

# Database
# Docker Compose persists this path through ./data:/app/data.
DATABASE_URL=sqlite:///./data/radar.db

# Scheduler
# Scheduler timezone: Asia/Shanghai (UTC+8)
RADAR_RUN_HOUR=8
RADAR_RUN_MINUTE=0
